# === Discord Bot ===
DISCORD_TOKEN=your_discord_bot_token_here
# Botが動作するギルド（サーバー）ID
GUILD_ID=your_guild_id_here

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here
# 使用するモデル (デフォルト: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# === チケット検知設定 ===
# チケットチャンネルが作成されるカテゴリID（カンマ区切りで複数指定可）
TICKET_CATEGORY_IDS=
# チケットチャンネル名のプレフィックス（カンマ区切りで複数指定可、デフォルト: ticket-）
TICKET_CHANNEL_PREFIXES=ticket-
# Ticket Tool BotのユーザーID（デフォルト: 557628352828014614）
TICKET_TOOL_BOT_ID=557628352828014614

# === 運営エスカレーション ===
# 運営スタッフのロールID（エスカレーション時にメンションされる）
STAFF_ROLE_ID=your_staff_role_id_here
# エスカレーション先のチャンネルID（ログ用、空の場合はチケットチャンネル内でメンション）
ESCALATION_LOG_CHANNEL_ID=

# === AI動作設定 ===
# AIのシステムプロンプト（サーバー固有のルール・FAQ等を記述）
# 長文の場合は config/system_prompt.txt に記述してください
AI_SYSTEM_PROMPT=
# AIが応答するまでの待機時間（秒）— ユーザーが追加メッセージを送る猶予
AI_RESPONSE_DELAY_SECONDS=10
# 会話履歴の最大メッセージ数
AI_MAX_HISTORY_MESSAGES=20

# === モデレーション（モラル違反検知）===
# モデレーションログの保存先ディレクトリ（デフォルト: ./logs/moderation/）
MODERATION_LOG_DIR=
# モデレーション通知チャンネルID（空の場合はエスカレーションログチャンネルを使用）
MODERATION_LOG_CHANNEL_ID=

# === 無関係な会話の自動クローズ ===
# 警告を出す無関係メッセージの回数（デフォルト: 1 = 最初の無関係メッセージで警告）
OFF_TOPIC_WARN_THRESHOLD=1
# 強制クローズする無関係メッセージの連続回数（デフォルト: 3）
OFF_TOPIC_CLOSE_THRESHOLD=3

# === チケットトラッカー ===
# チケットデータの保存先ディレクトリ（デフォルト: ./data/）
TICKET_DATA_DIR=

# === Webダッシュボード ===
# Webダッシュボードの有効/無効（デフォルト: true）
WEB_DASHBOARD_ENABLED=true
# Webダッシュボードのポート（デフォルト: 3000）
WEB_DASHBOARD_PORT=3000
# アクセス制御用トークン（空の場合は認証なし。本番では設定推奨）
WEB_DASHBOARD_TOKEN=
